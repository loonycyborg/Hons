import qualified Data.List.NonEmpty as NE
import Data.Foldable (Foldable(fold))

env =
  CC.toolEnv                                               +:
  envVar @(LocalVar "jobs")       (0 :: Int)              :+:
  envVar @(LocalVar "switch")     (Nothing :: Maybe Bool) :+:
  EnvNihil

prog = Builder CC.link (NE.:|[]) id [fs|example/hello|] (NE.singleton object)
object = Builder CC.compile (NE.:|[]) NE.head [fs|example/hello.o|] (Source <$> [filelist|example/hello.c|])

project = (defaultProject env) { builders = [prog], defaultTargets = [[fs|example/hello|]] }
