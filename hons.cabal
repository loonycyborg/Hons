cabal-version: 3.0
name: hons
version: 0.1.0.0
synopsis: SCons-like build tool
homepage: loonylinuxbox.mooo.com
license: LGPL-3.0-or-later
license-file: LICENSE
author: Sergey Popov
maintainer: loonycyborg@gmail.com
category: Development

library
  ghc-options: -threaded -O2
  exposed-modules:
    Action
    Builder
    CmdLine
    Db
    Decider
    DepGraph
    Environment
    Hons
    Node
    Project
    Taskmaster
    Tool.CC
    ToolTH
    Value
  other-modules:
    CmdLineCompat
    FileCompat
    ValueCompat

  build-depends:
    algebraic-graphs >=0.7,
    async,
    base,
    bytestring,
    containers,
    cryptohash-md5,
    data-reify,
    deepseq,
    directory,
    file-io,
    filepath >=1.5.0.0 && <2.0.0.0,
    hashable,
    os-string,
    makefile,
    beam-core,
    beam-sqlite,
    beam-migrate,
    sqlite-simple,
    tagged,
    template-haskell,
    text-short,
    text,
    time,
    transformers,
    unix >=2.8.5.1,
    unordered-containers,

  hs-source-dirs: src
  if !os(windows)
    hs-source-dirs: src/posix
  default-language: GHC2021
  default-extensions:
    NoFieldSelectors
    OverloadedRecordDot

executable hons
  main-is: Main.hs
  other-modules: Options
  ghc-options: -threaded -O2
  build-depends:
    algebraic-graphs >=0.7,
    base,
    directory,
    filepath >=1.5.0.0 && <2.0.0.0,
    ghc,
    ghc-boot,
    ghc-boot-th,
    ghc-paths,
    cabal-install,
    hons,
    optparse-applicative,
    text-short,
    time,
    transformers,
    unordered-containers,

  hs-source-dirs: app
  default-language: GHC2021
  default-extensions:
    NoFieldSelectors
    OverloadedRecordDot

test-suite hons-test
  default-language: GHC2021
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: MyLibTest.hs
  build-depends: base
